# Copy to .env and fill in.  .env is gitignored -- never commit real values.

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Telegram user ids allowed to talk to this bot, comma separated.
# Send /whoami to the bot, or message @userinfobot, to find yours.
TELEGRAM_ALLOWED_IDS=0000000000

# Optional. Without it the bot runs in offline mode: it still picks models
# and hands back their Thinking Steps, but does not analyse your case.
# Get one at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# --- Webhook (webhook.py) --------------------------------------------------
# Required for webhook mode. Telegram sends it back in a header on every
# request; requests without it are rejected. Generate one with:
#   python3 webhook.py --new-secret
# TELEGRAM_WEBHOOK_SECRET=

# The public https:// address of this deployment. If set, the webhook is
# registered with Telegram automatically at startup.
# PUBLIC_URL=https://your-host.example.com

# PORT=8080
# WEBHOOK_PATH=/telegram/webhook
# WEBHOOK_SYNC=1    # for hosts that freeze the process after the response

# --- Optional overrides ----------------------------------------------------
# "brief" (default): short answer + problem tree.  "full": the long analysis.
# ADVISOR_STYLE=brief
# ADVISOR_MODEL=claude-opus-5-5
# ADVISOR_STATE_FILE=./.state/conversations.json
# ADVISOR_LOG_LEVEL=INFO
