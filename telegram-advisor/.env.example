# Copy to .env and fill in.  .env is gitignored -- never commit real values.

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Telegram user ids allowed to talk to this bot, comma separated.
# Send /whoami to the bot, or message @userinfobot, to find yours.
TELEGRAM_ALLOWED_IDS=0000000000

# Optional. Without it the bot runs in offline mode: it still picks models
# and hands back their Thinking Steps, but does not analyse your case.
# Get one at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
# ADVISOR_MODEL=claude-opus-5-5
# ADVISOR_STATE_FILE=./.state/conversations.json
# ADVISOR_LOG_LEVEL=INFO
